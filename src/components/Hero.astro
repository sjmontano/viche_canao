---
import es from '../i18n/es.json';
---
<section class="relative min-h-[78vh] grid place-items-center overflow-hidden">
<img src="/fotos/hero.jpg" alt="Viche CANAO botella Penumbra río Atrato" class="absolute inset-0 w-full h-full object-cover opacity-60" fetchpriority="high" />
<div class="relative max-w-3xl px-4 text-center">
<p class="text-cana text-sm tracking-widest">{es.hero.eyebrow}</p>
<h1 class="font-display text-4xl md:text-6xl mt-3">{es.hero.title}</h1>
<p class="mt-4 text-crema/80">{es.hero.sub}</p>
<div class="mt-6 flex gap-3 justify-center"><a href="/catalogo" class="bg-ambar text-base px-5 py-3 rounded-full font-semibold">{es.hero.ctaCatalogo}</a><a href="/contacto" class="border border-white/20 px-5 py-3 rounded-full">{es.hero.ctaWhats}</a></div>
<p class="mt-4 text-xs text-muted">{es.mayor}</p>
</div>
</section>
