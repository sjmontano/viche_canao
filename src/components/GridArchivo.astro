---
import { getCollection } from 'astro:content';
const historias = await getCollection('historias');
---
<div class="grid md:grid-cols-2 gap-4">
{historias.map((h) => (
  <a href={`/archivo/${h.slug}`} class="bg-surf border border-white/10 rounded-2xl p-5 block">
    <p class="text-xs text-muted">{h.data.fecha}</p>
    <h3 class="font-display text-2xl mt-1">{h.data.titulo}</h3>
    <p class="text-sm text-muted mt-2">{h.data.resumen}</p>
  </a>
))}
</div>
