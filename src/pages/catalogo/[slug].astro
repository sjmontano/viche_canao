---
import Base from '../../layouts/Base.astro';
import WhatsAppCTA from '../../components/WhatsAppCTA.astro';
import { getCollection } from 'astro:content';
export async function getStaticPaths() {
  const productos = await getCollection('productos');
  return productos.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
---
<Base title={`${p.data.nombre} — Viche CANAO`} description={p.data.descripcion}>
<section class="max-w-3xl mx-auto px-4 py-12">
<img src={p.data.foto} alt={p.data.nombre} class="w-full h-80 object-cover rounded-2xl" />
<h1 class="font-display text-4xl mt-6">{p.data.nombre}</h1>
<p class="text-cana mt-2">{p.data.aroma}</p>
<p class="mt-4 text-crema/80">{p.data.descripcion}</p>
<p class="text-sm text-muted mt-2">Notas: {p.data.notas.join(', ')} · Usos: {p.data.usos}</p>
<div class="mt-6"><WhatsAppCTA msg={p.data.whatsapp_msg} /></div>
</section>
</Base>
